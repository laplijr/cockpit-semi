# Session cookie encryption — 32+ caractères aléatoires
# openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# Mot de passe du compte unique
NUXT_APP_PASSWORD=

# Neon Postgres, chaîne « pooled » (l'hôte contient -pooler)
NUXT_DATABASE_URL=

# Date simulée, au format AAAA-MM-JJ. Réservée au développement local :
# ne JAMAIS la définir sur Vercel. Partagée par `pnpm db:seed` et `pnpm dev`.
NUXT_COCKPIT_TODAY=

# Secret protégeant la route de cron ; Vercel l'envoie en en-tête Authorization.
NUXT_CRON_SECRET=

# Clé de l'API Claude : Imprévu et recherche de course (§ 6). Sans elle, ces
# deux fonctions répondent 503 et le reste de l'app marche normalement.
NUXT_ANTHROPIC_API_KEY=

# Clé OpenRouteService : itinéraires GPX d'un séjour de course (§ 9, P5.5).
# Compte gratuit sur openrouteservice.org. Sans elle, la fenêtre Itinéraires
# répond 503 et le reste de l'app marche normalement.
NUXT_ORS_API_KEY=
