# Session cookie encryption — 32+ caractères aléatoires
# openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# Neon Postgres, chaîne « pooled » (l'hôte contient -pooler)
NUXT_DATABASE_URL=

# Base des tests d'intégration. Ils la **vident** à chaque exécution : ne
# jamais y mettre la base de développement. Sans cette variable, les tests
# d'intégration se sautent et `pnpm test` ne touche à aucune base.
NUXT_TEST_DATABASE_URL=

# Il n'y a plus de mot de passe d'application depuis P8.4 : chaque personne a
# son compte. Le premier se crée avec `pnpm account:create`, les suivants par
# invitation depuis la page « Mes données ».

# Date simulée, au format AAAA-MM-JJ. Réservée au développement local :
# ne JAMAIS la définir sur Vercel. Partagée par `pnpm db:seed` et `pnpm dev`.
NUXT_COCKPIT_TODAY=

# Secret protégeant la route de cron ; Vercel l'envoie en en-tête Authorization.
NUXT_CRON_SECRET=

# Clé de l'API Claude : Imprévu, recherche de course et plan de nutrition
# (§ 6). Sans elle ces trois fonctions disparaissent de l'écran sans se
# commenter — plus de champ d'Imprévu dans la barre haute, plus de colonne de
# recherche dans une nouvelle course, plus de tuile de repas —, le cron ne
# revérifie plus les dates de course, et le reste de l'app marche normalement.
NUXT_ANTHROPIC_API_KEY=

# Clé OpenRouteService : itinéraires GPX d'un séjour de course (§ 9, P5.5).
# Compte gratuit sur openrouteservice.org. Sans elle, la tuile Itinéraires
# disparaît sans se commenter — les boucles déjà tracées restent lisibles et
# téléchargeables — et le reste de l'app marche normalement.
NUXT_ORS_API_KEY=
